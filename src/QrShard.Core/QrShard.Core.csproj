<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Memory-mapped payload source reads via pointer spans. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep Native-AOT/trimming analyzers active in ordinary builds. The CLI consumes this
         project, but building the library alone must still catch reflection-only regressions. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Embeddable codec package; the CLI tool ships separately as QrShard.Tool. -->
  <PropertyGroup>
    <PackageId>QrShard.Core</PackageId>
    <Version>1.7.3</Version>
    <Authors>Lee Farrand</Authors>
    <Description>Embeddable .NET 10 codec for QrShard screen-transfer images: encode files, decode image paths or bytes, track incremental sessions, recover damaged or missing shards, and publish SHA-256-verified output.</Description>
    <PackageProjectUrl>https://github.com/lfarrand/QrShard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lfarrand/QrShard</RepositoryUrl>
    <PackageTags>qr;screen-transfer;codec;file-transfer;air-gap;error-correction;erasure-coding;encryption</PackageTags>
    <Copyright>Copyright (c) 2026 Lee Farrand</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A package-specific readme: the repository README is written for GitHub and its relative
         image links would render broken on nuget.org. -->
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QrShard" />
    <InternalsVisibleTo Include="QrShard.Tests" />
    <InternalsVisibleTo Include="QrShard.Benchmarks" />
  </ItemGroup>

</Project>
