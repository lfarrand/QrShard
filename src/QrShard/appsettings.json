{
  // QrShard settings. This file is optional: delete a setting (or the whole file) to use the
  // defaults. JSON comments and trailing commas are allowed here — the parser skips them, the
  // same way standard .NET appsettings files do. Invalid values fail loudly at startup rather
  // than silently falling back.
  //
  // Deliberately NOT configurable: anything both sides of a transfer must agree on — frame
  // geometry, metadata-strip layout, magic numbers, Reed-Solomon/GF(2^8) parameters — plus the
  // decoder's detection heuristics. Those are protocol, not preference; a settings file on one
  // machine would silently break decoding on another.

  // ---- Encode defaults (each one is overridden by its CLI flag when given) ----
  "EncodeDefaults": {
    // -r/--resolution: "auto" detects the primary monitor's native resolution so shards fill
    // the screen they'll be captured from (falls back to 2160 when no display is available);
    // or one number (square) or WxH, 700-16384 per side, to override — e.g. a smaller size
    // to show the code surrounded by black padding on the display.
    "Resolution": "auto",
    // -c/--cell: data cell size in pixels, 1-64.
    "CellPx": 3,
    // -b/--bits: bits per cell (color density), 1-8.
    "BitsPerCell": 4,
    // -e/--ecc: Reed-Solomon parity bytes per 255-byte block; even, 0-64.
    "EccParity": 16,
    // -R/--recovery: extra parity images as % of data images, 0-100 (0 = off).
    "RecoveryPercent": 0,
    // -f/--format: png, bmp, tga, qoi, webp, or tiff.
    "ImageFormat": "png",
    // false is the same as always passing --no-compress.
    "Compress": true
  },

  // Folder created next to the input when -o/--out is not given: <file><suffix>.
  "ShardFolderSuffix": ".shards",

  // Deflate level for the built-in PNG writer, applied where compression pays off (cell sizes
  // >= 2 px, where the Up filter makes repeated rows compressible). Images with 1 px cells
  // always use Fastest, because their noise-like content is incompressible by construction.
  //
  // Possible values (System.IO.Compression.CompressionLevel, case-insensitive):
  //   "Optimal"       - default; ~10% smaller shards than Fastest at a modest encode-time cost
  //   "Fastest"       - ~25% quicker encode, ~45% larger shard files
  //   "SmallestSize"  - maximum compression; noticeably slower encode
  //   "NoCompression" - stored (uncompressed) PNGs; huge files, debugging only
  "PngCompressionLevel": "Optimal",

  // Compression level passed to BrotliStream for the file payload (same possible values).
  // Only consulted when compression is on and the content looks compressible.
  "PayloadCompressionLevel": "Optimal",

  // ---- Machine tuning ----

  // Planning budget (MB) for retained compressed/encrypted payload bytes, parity/FEC buffers,
  // and per-worker pixel canvases. Optional compression is skipped if its conservative transient
  // peak cannot fit; password encryption and fixed payload/parity plans that cannot leave room for
  // one canvas are refused. Remaining capacity caps parallel workers, also capped at core count.
  // Range 64-1000000.
  "EncodeMemoryBudgetMB": 2000,

  // Upper bound on parallel image decodes. 0 = automatic (number of cores, capped at 24).
  // Actual workers are also limited by the image count and DecodeMemoryBudgetMB, so raising this
  // setting alone may change nothing. A decode that pages costs more than extra workers gain.
  // Range 0-1024.
  "DecodeMaxParallelism": 0,

  // Memory budget (MB) for the decoder's per-worker scratch — the counterpart to
  // EncodeMemoryBudgetMB. Worker count is the lower of DecodeMaxParallelism and what this budget
  // affords, measured against the largest image in the set (read from its header before any
  // decoding). A 4K frame is planned at about 332 MB and a 48-megapixel photo at about 1.92 GB,
  // including the adaptive binarizer's two 8-byte-per-pixel integral images and measured
  // camera-fallback overhead. The default affords about 12 workers at 4K and 2 on 48 MP input.
  //
  // The same value independently bounds path/input materialization, retained valid shard payloads,
  // photo-fusion work, watch/video lifetime state, and retained session payload/header/key state. These
  // conservative gates are not one subtractive pool or a hard process-working-set ceiling. One image
  // must fit a pre-load gate of about 6 bytes/pixel. LOWER IT on a machine with less RAM to spare.
  // Range 64-1000000.
  "DecodeMemoryBudgetMB": 4000,

  // Live receiver defaults. ReceiveFps is >0-120; ReceiveDecodeWorkers is 0 (automatic) to 64;
  // WatchPollMs is 50-60000.
  "ReceiveFps": 10,
  "ReceiveDecodeWorkers": 0,
  "WatchPollMs": 250,

  // Optional absolute ffmpeg executable path. Omit it for a safe absolute PATH lookup. Relative
  // paths and discovery from the current/application directory are deliberately refused.
  // "FfmpegPath": "C:\\ffmpeg\\bin\\ffmpeg.exe"
}
