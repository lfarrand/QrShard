<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\QrShard.Core\QrShard.Core.csproj" />
    <ProjectReference Include="..\..\src\QrShard\QrShard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Match the CLI's GC mode so benchmark numbers reflect production behavior. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- The line above has said "match the CLI's GC mode" since it was written, but the CLI also
         disables DATAS and this project did not — so the published numbers measured a
         configuration that does not ship. Whether DATAS costs anything here is a separate
         question and is deliberately NOT asserted: the CLI's own comment cites 3-9% from an A/B
         on a 100 MB round trip, and that figure has not been re-measured. This change is about
         measuring what ships, not about a claimed win. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

</Project>
